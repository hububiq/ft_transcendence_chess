# Database Secrets
POSTGRES_USER=admin
POSTGRES_PASSWORD=<password> #password here needs to comply with password down below in URLs.
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# URLs for Microservices
DJANGO_DB_URL=postgres://admin:<password>@postgres_db:5432/django_db
FASTAPI_DB_URL=postgres://admin:<password>@postgres_db:5432/fastapi_db
REDIS_URL=redis://redis_broker:6379/0

# Secret key for Django and FastAPI to use.

SECRET_KEY = <paste_a_random_50_character_string_here>

GITHUB_CLIENT_ID=
GITHUB_SECRET=