# LOCAL DEVELOPMENT (SOLO TESTING)
# Use these values when building and testing on a single machine.
# Uncomment this section and comment out the LAN MULTIPLAYER section below.

# VITE_BASE_API_URL="http://localhost:8000"       # Django
# VITE_FASTAPI_URL="http://localhost:8001"        # FastAPI REST
# VITE_WS_BASE_URL="ws://localhost:8001"          # FastAPI WebSockets

# --------------------------------------------------------------
# -------------------------OBSOLETE-----------------------------
# --------------------------------------------------------------



# PRODUCTION / LAN CONFIGURATION (Nginx Gateway)
# Leave these blank so Axios and WebSockets default to relative paths 
# (Nginx will automatically route /api/ and /ws/ to the right container)
VITE_BASE_API_URL=""
VITE_FASTAPI_URL=""

# Use ws://<host-ip> for LAN testing, or wss://<domain> if using HTTPS
VITE_WS_BASE_URL="ws://<YOUR_LAN_IP>" 

# ---

# AUTHENTICATION & OAUTH
# Your GitHub OAuth Client ID for login.
# Note: If switching to LAN multiplayer, make sure to update your GitHub 
# OAuth App settings to accept your <server-ip> as the callback URL!

VITE_GITHUB_CLIENT_ID="your_github_client_id_here"